# Server Configuration
PORT=8080
HOST=0.0.0.0

# Engine & Concurrency Tuning
DEFAULT_AUCTION_DURATION_SEC=120
MIN_BID_INCREMENT=1
RATE_LIMIT_BUCKET_SIZE=10
RATE_LIMIT_REFILL_RATE=5
MAX_CONNECTIONS=60000
MAX_CONNECTIONS_PER_IP=50
EXEMPT_LOOPBACK_IP_LIMIT=true
BROADCAST_BATCH_INTERVAL_MS=50
PRESENCE_BROADCAST_INTERVAL_MS=1000
MAX_WS_BACKPRESSURE_BYTES=65536
VERBOSE_LOGS=false

# Optional Admin Portal & API Protection
ADMIN_USERNAME=admin123
ADMIN_PASSWORD=admin456
SESSION_SECRET=
ADMIN_KEY=

# Optional Supabase Persistence (PostgreSQL via PostgREST)
# Run supabase/schema.sql in your Supabase SQL Editor first.
# If omitted, the engine automatically uses local JSON persistence in ./data/store.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
